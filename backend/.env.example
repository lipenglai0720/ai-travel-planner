# 应用基础配置。
APP_NAME="AI 智能旅行规划系统（开发环境）"
APP_ENV=development

# 大模型配置。
# 模板保留空 Key；真实 Key 只填写到本地 .env。
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-flash"
LLM_TIMEOUT_SECONDS=30

# 高德 Web 服务 API Key。
# 配置示例保留空值，真实 Key 只填写到本地 .env。
AMAP_WEB_API_KEY=

# 高德 HTTP 请求超时参数，单位为秒。
AMAP_TIMEOUT_SECONDS=10